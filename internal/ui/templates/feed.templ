package templates

import (
	"fmt"
	"unicode/utf8"
	"github.com/perbu/mindgame/internal/db"
)

func actionBadgeClass(action string) string {
	switch action {
	case "ALLOW":
		return "badge badge-allow"
	case "BLOCK":
		return "badge badge-block"
	case "BAN":
		return "badge badge-ban"
	case "DENY":
		return "badge badge-deny"
	case "RESP_BLOCK":
		return "badge badge-resp-block"
	case "RESP_BAN":
		return "badge badge-resp-ban"
	default:
		return "badge badge-reject"
	}
}

func scoreClass(score int) string {
	switch {
	case score >= 20:
		return "score score-high"
	case score >= 10:
		return "score score-mid"
	default:
		return "score score-low"
	}
}

templ FeedPage(entries []db.AuditEntry) {
	@Layout("Live Feed", "feed") {
		<h1>Live Feed</h1>
		<div class="card">
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Time</th>
						<th>Action</th>
						<th>Method</th>
						<th>Host</th>
						<th>URL</th>
						<th>Score</th>
						<th>Reason</th>
					</tr>
				</thead>
				<tbody id="feed-body" hx-ext="sse" sse-connect="/feed/events" sse-swap="message" hx-swap="afterbegin">
					for _, e := range entries {
						@FeedRow(e)
					}
				</tbody>
			</table>
		</div>
		<script>
			function toggleDetail(row) {
				var detailRow = row.nextElementSibling;
				if (!detailRow || !detailRow.classList.contains("detail-row")) return;
				// First click: htmx is loading content, let afterSwap handle it
				if (detailRow.innerHTML.trim() === "") return;
				// Toggle visibility
				if (detailRow.style.display === "table-row") {
					detailRow.style.display = "none";
					row.classList.remove("expanded");
				} else {
					detailRow.style.display = "table-row";
					row.classList.add("expanded");
				}
			}

			document.body.addEventListener("htmx:afterSwap", function(evt) {
				var detailRow = evt.detail.target;
				if (!detailRow.classList.contains("detail-row")) return;
				detailRow.style.display = "table-row";
				var parentRow = detailRow.previousElementSibling;
				if (parentRow) parentRow.classList.add("expanded");
			});
		</script>
	}
}

templ FeedRow(e db.AuditEntry) {
	<tr id={ fmt.Sprintf("row-%d", e.ID) } hx-get={ fmt.Sprintf("/feed/detail/%d", e.ID) } hx-target={ fmt.Sprintf("#detail-%d", e.ID) } hx-swap="innerHTML" hx-trigger="click once" onclick="toggleDetail(this)" style="cursor:pointer">
		<td class="mono">{ fmt.Sprintf("%d", e.ID) }</td>
		<td class="mono">{ e.Timestamp.Format("15:04:05") }</td>
		<td><span class={ actionBadgeClass(e.Action) }>{ e.Action }</span></td>
		<td>{ e.Method }</td>
		<td>{ e.Host }</td>
		<td class="truncate" title={ e.URL }>{ e.URL }</td>
		<td><span class={ scoreClass(e.TotalScore()) }>{ fmt.Sprintf("%d", e.TotalScore()) }</span></td>
		<td class="truncate" title={ e.Reason }>{ e.Reason }</td>
	</tr>
	<tr id={ fmt.Sprintf("detail-%d", e.ID) } class="detail-row"></tr>
}

templ FeedDetail(e *db.AuditEntry) {
	<td colspan="8">
		<div class="detail">
			<dl>
				<dt>Full URL</dt>
				<dd class="mono">{ e.URL }</dd>
				<dt>Reason</dt>
				<dd>{ e.Reason }</dd>
				if db.StatusReasonText(e.Action) != "" {
					<dt>Status Reason</dt>
					<dd>{ db.StatusReasonText(e.Action) }</dd>
				}
				if e.RespRiskScore > 0 {
					<dt>Total Risk Score</dt>
					<dd><span class={ scoreClass(e.TotalScore()) }>{ fmt.Sprintf("%d", e.TotalScore()) }</span></dd>
				}
				<dt>Request Risk Score</dt>
				<dd><span class={ scoreClass(e.RiskScore) }>{ fmt.Sprintf("%d", e.RiskScore) }</span></dd>
				<dt>Request Signals</dt>
				<dd class="mono">{ e.RiskSignals }</dd>
				if e.RespRiskScore > 0 {
					<dt>Response Risk Score</dt>
					<dd><span class={ scoreClass(e.RespRiskScore) }>{ fmt.Sprintf("%d", e.RespRiskScore) }</span></dd>
					<dt>Response Signals</dt>
					<dd class="mono">{ e.RespRiskSignals }</dd>
				}
				if e.RespStatus > 0 {
					<dt>Response Status</dt>
					<dd>{ fmt.Sprintf("%d", e.RespStatus) }</dd>
				}
				<dt>Request Headers</dt>
				<dd><pre>{ e.ReqHeaders }</pre></dd>
				if len(e.ReqBody) > 0 {
					<dt>Request Body</dt>
					<dd><pre>{ truncateBody(e.ReqBody, 2000) }</pre></dd>
				}
				if len(e.RespBody) > 0 {
					<dt>Response Body</dt>
					<dd><pre>{ truncateBody(e.RespBody, 2000) }</pre></dd>
				}
			</dl>
		</div>
	</td>
}

func truncateBody(b []byte, max int) string {
	if len(b) == 0 {
		return ""
	}
	if utf8.Valid(b) {
		s := string(b)
		if len(s) <= max {
			return s
		}
		return s[:max] + "..."
	}
	return fmt.Sprintf("[binary, %d bytes]", len(b))
}
