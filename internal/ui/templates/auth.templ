package templates

templ AuthPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Login - MindGame</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<nav>
				<span class="brand">MindGame</span>
			</nav>
			<div class="container" style="max-width: 400px; margin-top: 4rem;">
				<div class="card" style="text-align: center;">
					<h1 style="margin-bottom: 0.5rem;">Authentication</h1>
					<p style="color: var(--text-dim); margin-bottom: 1.5rem; font-size: 0.9rem;">
						Click the button below to generate a one-time login code.
						The code will appear in the server logs. You have 30 seconds to enter it.
					</p>
					<div id="auth-area">
						<button hx-post="/auth/challenge" hx-target="#auth-area" hx-swap="innerHTML">
							Generate Login Code
						</button>
					</div>
				</div>
			</div>
		</body>
	</html>
}

templ AuthChallengeForm() {
	<form hx-post="/auth/verify" hx-target="#auth-area" hx-swap="innerHTML">
		<p style="color: var(--green); margin-bottom: 1rem; font-size: 0.85rem;">
			Code generated — check your server logs.
		</p>
		<div class="form-group" style="margin-bottom: 1rem;">
			<label for="code">Login Code</label>
			<input type="text" id="code" name="code" placeholder="e.g. A3KW7B" autocomplete="off" autofocus
				style="text-align: center; font-size: 1.2rem; letter-spacing: 0.3em; text-transform: uppercase;"/>
		</div>
		<button type="submit">Verify</button>
	</form>
}

templ AuthError(msg string) {
	<form hx-post="/auth/verify" hx-target="#auth-area" hx-swap="innerHTML">
		<p style="color: var(--red); margin-bottom: 1rem; font-size: 0.85rem;">
			{ msg }
		</p>
		<div class="form-group" style="margin-bottom: 1rem;">
			<label for="code">Login Code</label>
			<input type="text" id="code" name="code" placeholder="e.g. A3KW7B" autocomplete="off" autofocus
				style="text-align: center; font-size: 1.2rem; letter-spacing: 0.3em; text-transform: uppercase;"/>
		</div>
		<button type="submit" style="margin-right: 0.5rem;">Retry</button>
		<button type="button" hx-post="/auth/challenge" hx-target="#auth-area" hx-swap="innerHTML" class="btn-secondary">
			New Code
		</button>
	</form>
}
